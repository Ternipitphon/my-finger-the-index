@echo off
setlocal
set "CAPRII_QUIZ_ROOT=%~dp0"
echo Starting the local math quiz...
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; $page=Join-Path $env:CAPRII_QUIZ_ROOT 'index.html'; if (-not (Test-Path -LiteralPath $page)) { throw 'Extract the whole math-quiz ZIP before opening this file.' }; $body=[IO.File]::ReadAllBytes($page); $listener=New-Object Net.Sockets.TcpListener([Net.IPAddress]::Loopback,8787); $listener.Start(); Write-Host 'Math quiz is ready: http://127.0.0.1:8787'; Write-Host 'Keep this window open. Close it to stop the quiz server.'; Start-Process 'http://127.0.0.1:8787'; try { while ($true) { $client=$listener.AcceptTcpClient(); try { $client.ReceiveTimeout=2000; $client.SendTimeout=2000; $stream=$client.GetStream(); $buffer=New-Object byte[] 8192; $count=0; while ($count -lt $buffer.Length) { $n=$stream.Read($buffer,$count,$buffer.Length-$count); if ($n -eq 0) { break }; $count+=$n; if ([Text.Encoding]::ASCII.GetString($buffer,0,$count).Contains(([string][char]13+[char]10+[char]13+[char]10))) { break } }; if ($count -eq 0) { continue }; $request=[Text.Encoding]::ASCII.GetString($buffer,0,$count); $status='200 OK'; $payload=$body; if (-not $request.StartsWith('GET /')) { $status='405 Method Not Allowed'; $payload=New-Object byte[] 0 }; if ($request.StartsWith('GET /favicon.ico ')) { $status='204 No Content'; $payload=New-Object byte[] 0 }; $header='HTTP/1.1 '+$status+([string][char]13+[char]10+'Content-Type: text/html; charset=utf-8'+[char]13+[char]10+'Cache-Control: no-store'+[char]13+[char]10+'Connection: close'+[char]13+[char]10+'Content-Length: ')+$payload.Length+([string][char]13+[char]10+[char]13+[char]10); $headers=[Text.Encoding]::ASCII.GetBytes($header); $stream.Write($headers,0,$headers.Length); $stream.Write($payload,0,$payload.Length) } catch { } finally { $client.Close() } } } finally { $listener.Stop() }"
if errorlevel 1 (
 echo Could not start. Check the error above. Port 8787 may already be in use.
 pause
)
