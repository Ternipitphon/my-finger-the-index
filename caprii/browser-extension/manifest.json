{
  "manifest_version": 3,
  "name": "Caprii — เชื่อม Chrome",
  "version": "0.7.3",
  "description": "เชื่อมแท็บที่เลือก หรือเลือกจำการเชื่อม Chrome และตามแท็บใช้งานอัตโนมัติ",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:47824/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
